{
  "name": "helpi-api",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate --schema=prisma/schema.prisma && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:setup": "prisma validate && prisma generate && prisma migrate deploy && npm run country:seed",
    "db:status": "prisma migrate status",
    "db:export:supabase": "node scripts/generate-supabase-sql.mjs",
    "db:baseline:supabase": "node scripts/baseline-supabase-sql.mjs",
    "test:build": "npm run build",
    "country:seed": "node seed-country-config.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.6",
    "@prisma/client": "^6.14.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "prisma": "^6.14.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.2"
    },
    "@nestjs/cli": {
      "glob": "14.0.2"
    }
  }
}
