NODE_ENV=development
PORT=3000
# Runtime URL. For Vercel/Supabase Prisma, use the Transaction pooler URL on port 6543 with pgbouncer=true.
DATABASE_URL=postgresql://helpi:change-this-password@localhost:5432/helpi?schema=public
# Prisma migrations/baseline URL. For Supabase, use the Session pooler URL on port 5432.
DIRECT_URL=postgresql://helpi:change-this-password@localhost:5432/helpi?schema=public
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
ACCESS_TOKEN_TTL=10m
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
FX_PROVIDER_URL=
EXPOSE_DEV_TOKENS=false
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_WEBHOOK_SECRET=replace-with-a-long-random-secret
MFA_ENCRYPTION_KEY_B64=replace-with-base64-encoded-32-random-bytes
EMAIL_WEBHOOK_URL=
RESEND_API_KEY=
EMAIL_FROM=Helpi <onboarding@resend.dev>
EMAIL_VERIFICATION_BASE_URL=https://helpi-eight.vercel.app/community/
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret

# Private object storage / KMS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_KMS_KEY_ID=
STORAGE_BUCKET=
MAX_UPLOAD_BYTES=10485760

# Document OCR / verification
OCR_PROVIDER_URL=
OCR_PROVIDER_API_KEY=
KYC_PROVIDER_URL=
KYC_PROVIDER_API_KEY=
SANCTIONS_PROVIDER_URL=
SANCTIONS_PROVIDER_API_KEY=

# Push notifications
FCM_SERVER_KEY=

# Voice/video provider
VIDEO_PROVIDER=
VIDEO_PROVIDER_API_KEY=

# Payment providers
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_WEBHOOK_SECRET=
HIGH_VALUE_MINOR=1000000
